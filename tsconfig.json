{
  
    "compilerOptions": {
      "target": "ES2020",                          /* コンパイル後のJavaScriptのバージョン */
      "module": "commonjs",                        
      "outDir": "./dist",                          /* JSファイルの出力先フォルダ */
      "rootDir": "./src",                          /* TSファイルを配置するフォルダ */
      "strict": true,                              /* 厳密な型チェックを有効化 */
      "esModuleInterop": true,
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true
    }
